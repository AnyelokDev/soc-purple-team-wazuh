<!-- Purple Team demo: ENRIQUECIMIENTO de T1136 (no es un hueco).
     La regla de fabrica 5902 ("New user added", nivel 8) ya detecta la creacion de cuentas
     y la mapea a T1136. Esta regla hija hereda esa deteccion, sube el nivel a 10 (dentro del
     umbral de respuesta activa) y anade la descripcion de persistencia. Aplicar EN VIVO. -->
<group name="local,syslog,adduser,">
  <rule id="100200" level="10">
    <if_sid>5902</if_sid>
    <description>Persistencia: cuenta local creada (mapeada a ATT&amp;CK T1136 por Fable 5.1).</description>
    <mitre>
      <id>T1136</id>
    </mitre>
    <group>account_manipulation,persistence,</group>
  </rule>
</group>
